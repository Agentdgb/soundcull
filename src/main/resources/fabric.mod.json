{
  "schemaVersion": 1,
  "id": "soundcull",
  "version": "${version}",
  "name": "SoundCull",
  "description": "Lightweight client-side Fabric mod that silences redundant ambient and mob sound spam to prevent OpenAL audio channel starvation.",
  "authors": [
    "Agentdgb"
  ],
  "contact": {
    "homepage": "https://github.com/Agentdgb/soundcull",
    "sources": "https://github.com/Agentdgb/soundcull",
    "issues": "https://github.com/Agentdgb/soundcull/issues"
  },
  "license": "MIT",
  "icon": "assets/soundcull/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.soundcull.SoundCullClient"
    ]
  },
  "mixins": [
    "soundcull.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": ">=1.21"
  }
}
